# Přesměrování na https://www.pilabilina.cz
# POZOR: nahrajte až po zapnutí SSL certifikátu v administraci Active24,
# jinak se web nenačte.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.pilabilina.cz%{REQUEST_URI} [L,R=301]

# Kódování a cache
AddDefaultCharset UTF-8
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
